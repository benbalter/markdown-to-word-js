{
  // Astro's strict preset, covering the site (web/), the converter (src/), the
  // tests, and the config files, so `npm run typecheck` checks all of them.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    ".astro/types.d.ts",
    "web/**/*",
    "src/**/*",
    "test/**/*",
    "scripts/**/*",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["dist", "node_modules"]
}
