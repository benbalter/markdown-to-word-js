{
  "name": "markdown-to-word",
  "version": "1.0.0",
  "private": true,
  "description": "Convert GitHub Flavored Markdown to Word documents in the browser",
  "type": "module",
  "engines": {
    "node": ">= 22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check --minimumSeverity error && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:i18n": "node scripts/translate-i18n.mjs",
    "gen:icons": "sh scripts/gen-icons.sh",
    "cf:builds": "node scripts/cloudflare-builds.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@nuasite/checks": "^0.56.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "~26",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "^7.3.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mammoth": "^1.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.23.1",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "marked": "^18.1.1"
  },
  "author": "Ben Balter <ben@balter.com>",
  "license": "MIT",
  "homepage": "https://md2word.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/benbalter/markdown-to-word-js.git"
  },
  "keywords": [
    "markdown",
    "word",
    "docx",
    "converter",
    "github-flavored-markdown",
    "gfm"
  ]
}
