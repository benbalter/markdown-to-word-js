{
  "name": "markdown-to-word",
  "version": "1.0.0",
  "description": "Convert GitHub Flavored Markdown to Word documents in the browser",
  "type": "module",
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "dev": "npx vite dev --host",
    "build": "npx tsc && npx vite build",
    "preview": "npx vite preview",
    "lint": "npx eslint . --ext .ts --fix",
    "format": "npx prettier --write .",
    "test": "npx vitest run"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/marked": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "mammoth": "^1.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.23.1",
    "bootstrap": "^5.3.8",
    "clipboard": "^2.0.11",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "marked": "^11.1.1"
  },
  "author": "Ben Balter <ben@balter.com>",
  "license": "MIT",
  "homepage": "https://benbalter.com/markdown-to-word-js/",
  "repository": {
    "type": "git",
    "url": "https://github.com/benbalter/markdown-to-word-js.git"
  },
  "keywords": [
    "markdown",
    "word",
    "docx",
    "converter",
    "github-flavored-markdown",
    "gfm"
  ]
}
