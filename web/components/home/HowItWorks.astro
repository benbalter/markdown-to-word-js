---
// "How it works": the three-step grid. Step icons are presentational and
// locale-independent, so they live here and pair with t.steps by index.
import { useTranslations } from '../../i18n';

const t = useTranslations(Astro.currentLocale);

const stepIcons = [
  // Paste or drop a file in (an arrow into a document, not an upload arrow:
  // nothing leaves the device)
  '<path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M2 15h10"/><path d="m9 18 3-3-3-3"/>',
  // Convert (transform / two-way arrows)
  '<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>',
  // Download the .docx
  '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/>',
];
---

<section class="mx-auto mt-20 max-w-3xl">
  {/* An ordered list, not three h2s: the steps are a sequence inside the
       page, not sections of it, so they shouldn't sit at the same heading
       level as "What gets converted". The list carries the order for screen
       readers, so the visual step number is hidden from them. role="list"
       keeps Safari announcing it as a list once Tailwind removes the markers. */}
  <ol role="list" class="grid gap-px overflow-hidden rounded-xl border border-rule-light bg-rule-light sm:grid-cols-3 dark:border-rule-dark dark:bg-rule-dark">
    {
      t.steps.map((step, i) => (
        <li class="bg-paper px-6 py-7 dark:bg-ink">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-chartreuse/40 bg-chartreuse/10 text-chartreuse-deep dark:text-chartreuse">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={stepIcons[i]}
              />
            </span>
            <span
              class="font-mono text-sm font-bold text-chartreuse-deep dark:text-chartreuse"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <p class="mt-3 font-display text-lg font-medium text-navy dark:text-snow">
            {step.t}
          </p>
          <p class="mt-1 text-sm leading-relaxed text-navy-soft dark:text-mist">
            {step.d}
          </p>
        </li>
      ))
    }
  </ol>
</section>
