---
// "Going the other way?" callout: points visitors who need Word → Markdown at
// the sibling converter. The link carries a utm_source, so it stays distinct
// from the footer's plain word2md.com href (Playwright locators are strict).
import { useTranslations } from '../../i18n';
import { UTM_SOURCE, WORD_TO_MARKDOWN_URL } from '../../site';

const t = useTranslations(Astro.currentLocale);
const href = `${WORD_TO_MARKDOWN_URL}/?utm_source=${UTM_SOURCE}&utm_medium=referral&utm_campaign=reverse`;
---

<section class="mx-auto mt-16 max-w-2xl">
  <div
    class="flex flex-col items-start gap-4 rounded-xl border border-rule-light bg-paper-card/60 px-6 py-6 sm:flex-row sm:items-center sm:justify-between dark:border-rule-dark dark:bg-ink-card/50"
  >
    <div>
      <h2
        class="font-display text-lg font-medium text-navy dark:text-snow"
      >
        {t.reverseHeading}
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-navy-soft dark:text-mist">
        {t.reverseBody}
      </p>
    </div>
    <a
      href={href}
      class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-navy/15 bg-paper-card px-3.5 py-2 text-sm font-medium text-navy transition-colors hover:border-chartreuse hover:bg-chartreuse/10 dark:border-white/15 dark:bg-ink-card dark:text-snow dark:hover:border-chartreuse"
    >
      {t.reverseCta}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="rtl:-scale-x-100"
        aria-hidden="true"
      >
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </svg>
    </a>
  </div>
</section>
