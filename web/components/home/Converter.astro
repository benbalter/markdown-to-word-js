---
// Converter: the input (dropzone, paste box, style) and the post-conversion
// results panels. The element ids and data-* attributes here are the contract
// with the browser logic in src/index.ts — keep them in sync with that module.
import { useTranslations } from '../../i18n';
import { UTM_SOURCE } from '../../site';

const t = useTranslations(Astro.currentLocale);
const resultsPromoUrl = `https://open-and-async.com/?utm_source=${UTM_SOURCE}&utm_medium=referral&utm_campaign=results`;
---

<section
  class="reveal mx-auto mt-10 max-w-2xl [--reveal-delay:.24s]"
  aria-label={t.convertSectionAria}
>
  {/* Polite live region: a successful conversion announces here for screen
       readers (the results reveal is otherwise silent). */}
  <div id="sr-status" role="status" class="sr-only"></div>

  <div
    id="input"
    data-error-generic={t.errorGeneric}
    data-file-too-large={t.fileTooLargeError}
    data-not-markdown-file-error={t.notMarkdownFileError}
    data-docx-file-error={t.docxFileError}
    data-read-error={t.readError}
    data-empty-error={t.emptyError}
    data-copy-failed={t.copyFailed}
    data-only-first-file={t.onlyFirstFile}
    data-conversion-announcement={t.conversionAnnouncement}
    data-converting={t.convertingStatus}
    data-copied={t.copiedButton}
    data-downloaded={t.downloadedButton}
    data-dismiss={t.dismiss}
  >
    <label
      for="file"
      id="dropzone"
      class="dropzone group flex cursor-pointer flex-col items-center rounded-2xl px-6 py-12 text-center backdrop-blur-sm"
    >
      <span
        class="dropzone-icon mb-5 inline-flex h-14 w-14 items-center justify-center rounded-full border border-chartreuse/40 bg-chartreuse/10 text-chartreuse-deep transition-transform dark:text-chartreuse"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          {/* A file going in, not an upload arrow: nothing leaves the device. */}
          <path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4" />
          <path d="M14 2v4a2 2 0 0 0 2 2h4" />
          <path d="M2 15h10" />
          <path d="m9 18 3-3-3-3" />
        </svg>
      </span>
      {/* "Drop" is the wrong verb on a phone: touch screens get "Choose a .md
           file" and lose the "or click to choose" line. The input takes its
           name from this <label>'s visible text, so the name matches what each
           device shows (the display:none variant drops out) and voice-control
           users can say what they see. */}
      <span class="font-display text-xl font-medium text-navy dark:text-snow">
        <span class="pointer-coarse:hidden">{t.dropzoneTitle}</span>
        <span class="hidden pointer-coarse:inline"
          >{t.dropzoneTitleTouch}</span
        >
      </span>
      <span
        class="mt-1.5 text-sm text-navy-soft pointer-coarse:hidden dark:text-mist"
      >
        {t.dropzoneBrowsePrefix}<span
          class="font-medium text-chartreuse-deep underline decoration-2 underline-offset-2 dark:text-chartreuse"
          >{t.dropzoneBrowseLink}</span
        >
      </span>
      {/* Reassurance at the moment of handing over a possibly sensitive file.
           aria-hidden keeps it out of the input's name; aria-describedby
           still reads it as the description. */}
      <span
        id="dropzone-note"
        aria-hidden="true"
        class="mt-5 block max-w-xs font-mono text-[0.72rem] tracking-wide text-balance text-navy-soft sm:max-w-none rtl:font-sans rtl:tracking-normal dark:text-mist"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="me-1.5 inline-block align-[-2px] text-chartreuse-deep dark:text-chartreuse"
          aria-hidden="true"
        >
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        {t.dropzoneNote}
      </span>
      <input
        type="file"
        id="file"
        aria-describedby="dropzone-note"
        accept=".md,.markdown,.mdown,.mkd,.txt,text/markdown,text/plain"
        class="sr-only"
      />
    </label>

    {/* The other way in: paste. Same panel chrome as the Markdown result. */}
    <div class="mt-6 flex items-center gap-3" aria-hidden="true">
      <span class="rule flex-1"></span>
      <span
        class="font-mono text-[0.72rem] tracking-[0.18em] text-navy-soft uppercase rtl:font-sans rtl:tracking-normal dark:text-mist"
        >{t.orPaste}</span
      >
      <span class="rule flex-1"></span>
    </div>

    <div
      class="md-panel panel-focus relative mt-4 overflow-hidden rounded-xl border border-rule-light bg-paper-card dark:border-rule-dark dark:bg-ink-card"
    >
      <div
        class="flex items-center gap-2 border-b border-rule-light px-4 py-2 dark:border-rule-dark"
      >
        <span class="h-2.5 w-2.5 rounded-full bg-navy-soft dark:bg-mist"></span>
        <label
          for="markdown-input"
          class="font-mono text-xs font-medium tracking-wide text-navy-soft uppercase rtl:font-sans rtl:tracking-normal dark:text-mist"
          >{t.panelMarkdown}</label
        >
      </div>
      <textarea
        id="markdown-input"
        rows="9"
        dir="ltr"
        spellcheck="false"
        placeholder={t.pastePlaceholder}
        class="block w-full resize-y bg-transparent px-4 py-3 font-mono text-[0.82rem] leading-relaxed text-navy placeholder:text-navy-soft dark:text-snow dark:placeholder:text-mist"
      ></textarea>
    </div>

    <div
      class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between"
    >
      <div class="flex flex-col gap-1 text-start">
        <label
          for="font-preset"
          class="font-mono text-[0.72rem] font-medium tracking-wide text-navy-soft uppercase rtl:font-sans rtl:tracking-normal dark:text-mist"
          >{t.styleLabel}</label
        >
        <select
          id="font-preset"
          aria-describedby="font-preset-hint"
          class="min-h-11 rounded-lg border border-rule-light bg-paper-card px-3 py-2 text-sm text-navy focus-visible:outline-2 dark:border-rule-dark dark:bg-ink-card dark:text-snow"
        >
          <option value="">{t.styleDefault}</option>
          <option value="chinese-official">{t.styleChineseOfficial}</option>
        </select>
      </div>
      <button
        id="convert-button"
        type="button"
        class="btn btn-accent disabled:cursor-not-allowed disabled:opacity-60"
        disabled
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="rtl:-scale-x-100"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
        <span id="convert-label">{t.convertButton}</span>
      </button>
    </div>
    {/* Suggests the 公文 preset when the text is mostly Chinese and no style
         is chosen; src/index.ts toggles it. */}
    <p
      id="font-preset-hint"
      class="mt-2 hidden text-start text-sm text-navy-soft dark:text-mist"
    >
      {t.styleChineseHint}
    </p>
  </div>

  {/* Results (revealed after a successful conversion) */}
  <div id="results" class="hidden scroll-mt-6">
    <div class="mt-4 flex flex-col items-center gap-3 sm:items-start">
      <h2
        class="max-w-full text-center font-display text-lg font-medium text-navy sm:text-start dark:text-snow"
      >
        {t.convertedLabel}{' '}<bdi
          id="filename"
          class="fresh-mark font-mono text-base break-all text-chartreuse-deep dark:text-chartreuse"
        ></bdi>
      </h2>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {/* One filled accent: the next action, which is getting the .docx. */}
        <button
          id="download-button"
          type="button"
          class="btn btn-accent confirmable"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="idle-icon"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="M7 10l5 5 5-5" />
            <path d="M12 15V3" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="confirm-icon"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" pathLength="1" />
          </svg>
          <span id="download-label">{t.downloadButton}</span>
        </button>
        {/* Rich text on the clipboard pastes straight into Word or Google
             Docs, skipping the file altogether. */}
        <button
          id="copy-button"
          type="button"
          class="btn btn-secondary confirmable"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="idle-icon"
            aria-hidden="true"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="confirm-icon"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" pathLength="1" />
          </svg>
          <span id="copy-label">{t.copyButton}</span>
        </button>
        <button id="convert-another" type="button" class="btn btn-secondary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 12a9 9 0 0 1 9-9 9 9 0 0 1 6.7 3H21" />
            <path d="M21 3v3h-3" />
            <path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-6.7-3H3" />
            <path d="M3 21v-3h3" />
          </svg>
          {t.convertAnother}
        </button>
      </div>
    </div>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      {/* The Preview panel is the "output" here, so it gets the lit diff
           wash on conversion (see .md-panel in global.css). */}
      <div
        class="panel-focus overflow-hidden rounded-xl border border-rule-light bg-paper-card dark:border-rule-dark dark:bg-ink-card"
      >
        <div
          class="flex items-center gap-2 border-b border-rule-light px-4 py-2 dark:border-rule-dark"
        >
          <span class="h-2.5 w-2.5 rounded-full bg-navy-soft dark:bg-mist"
          ></span>
          <span
            class="font-mono text-xs font-medium tracking-wide text-navy-soft uppercase rtl:font-sans rtl:tracking-normal dark:text-mist"
            >{t.panelMarkdown}</span
          >
        </div>
        <pre
          class="max-h-[28rem] overflow-auto px-4 py-3 text-start whitespace-pre-wrap [overflow-wrap:anywhere]"
          dir="ltr"
          tabindex="0"
          data-select-all><code id="source" class="font-mono text-[0.82rem] leading-relaxed text-navy dark:text-snow"></code></pre>
      </div>

      <div
        class="md-panel panel-focus relative overflow-hidden rounded-xl border border-rule-light bg-paper-card dark:border-rule-dark dark:bg-ink-card"
      >
        <div
          class="flex items-center gap-2 border-b border-rule-light px-4 py-2 dark:border-rule-dark"
        >
          <span class="md-dot h-2.5 w-2.5 rounded-full bg-chartreuse"></span>
          <span
            class="font-mono text-xs font-medium tracking-wide text-navy-soft uppercase rtl:font-sans rtl:tracking-normal dark:text-mist"
            >{t.panelPreview}</span
          >
        </div>
        <div
          id="rendered"
          dir="auto"
          tabindex="0"
          data-select-all
          class="prose prose-sm max-h-[28rem] max-w-none overflow-auto px-4 py-3 font-display text-start dark:prose-invert"
        >
        </div>
      </div>
    </div>

    {/* Contextual Open & Async pitch after a successful conversion. It is the
         only ask on the results screen (src/index.ts hides the standalone
         Promo card on success), but it stays quiet: a hairline row with a text
         link, so the filled accent belongs to Download. */}
    <div
      class="mt-6 flex flex-col gap-1.5 rounded-xl border border-rule-light px-4 py-3 text-start text-sm sm:flex-row sm:items-center sm:justify-between sm:gap-4 dark:border-rule-dark"
    >
      <p class="leading-relaxed text-navy-soft dark:text-mist">
        {t.promo.resultsLead}
      </p>
      <a
        href={resultsPromoUrl}
        class="inline-flex shrink-0 items-center gap-1.5 font-medium whitespace-nowrap text-chartreuse-deep underline decoration-chartreuse/50 decoration-2 underline-offset-4 transition-colors hover:decoration-chartreuse dark:text-chartreuse"
      >
        {t.promo.resultsCta}
        <span aria-hidden="true" class="rtl:-scale-x-100">&rarr;</span>
      </a>
    </div>
  </div>
</section>
