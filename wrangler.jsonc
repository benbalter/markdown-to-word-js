// Cloudflare Workers Static Assets: serves dist/ (from `npm run build`) at the
// custom domain through the ASSETS binding. `run_worker_first` runs
// worker/index.js only for "/", where it applies the Accept-Language redirect
// (or tags the page with a language suggestion), and for every page with a
// Markdown twin, which answers `Accept: text/markdown` with it (keep this list
// in step with web/agent/markdown.ts; test/agent-markdown.test.ts checks), and
// for "/api/event", the anonymous conversion counter. Every other request is a static asset that never reaches the Worker. Deploys run in Workers Builds
// on push (see docs/cloudflare.md); don't run `wrangler deploy` by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-to-word-js",
  // The account that owns the md2word.app zone. Pinned so a local deploy from
  // a login with several accounts can't land in the wrong one (not a secret).
  "account_id": "257c6aae4bebbdcd5bbe1d9136c08f1a",
  "compatibility_date": "2026-10-01",
  // Serve only on the custom domain; branch builds get preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Must match SITE_HOST in web/site.ts.
  "routes": [{ "pattern": "md2word.app", "custom_domain": true }],
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/chatgpt-to-word/",
      "/markdown-tables-to-word/",
      "/developers/",
      "/privacy/",
      "/terms/",
      "/api/event",
    ],
    // Unknown paths get the branded web/pages/404.astro with a 404 status.
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
  // Workers Analytics Engine dataset backing the conversion counter, as on
  // word2md.com. The Worker writes one fire-and-forget data point per
  // conversion (no content, filename, size, IP, or per-user id): blob1
  // 'convert', blob2 the outcome, blob3 the page's locale, blob4 how it
  // started (drop, paste, webmcp). Query via the SQL API:
  //   SELECT SUM(double1) FROM md2word_events WHERE blob1 = 'convert'
  //   SELECT blob4, SUM(double1) FROM md2word_events WHERE blob1 = 'convert' GROUP BY blob4
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "md2word_events" },
  ],
  // Branch builds run `wrangler preview` (Worker Previews), which refuses to
  // run without this block. Previews write to a separate dataset so beacons
  // from preview pages never count in production totals.
  "previews": {
    "analytics_engine_datasets": [
      { "binding": "EVENTS", "dataset": "md2word_events_preview" },
    ],
  },
}
