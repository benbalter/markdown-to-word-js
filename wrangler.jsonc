// Cloudflare Workers Static Assets: serves dist/ (from `npm run build`) at the
// custom domain. There's no Worker script (`main`), so every request is a
// static asset. Deploys run in Workers Builds on push (see docs/cloudflare.md);
// don't run `wrangler deploy` by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-to-word-js",
  "compatibility_date": "2026-10-01",
  // Serve only on the custom domain; branch builds get preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Must match SITE_HOST in web/site.ts.
  "routes": [{ "pattern": "md2word.app", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Unknown paths get the branded web/pages/404.astro with a 404 status.
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
}
